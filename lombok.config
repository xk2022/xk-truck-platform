# -------------------------------------------------------------------
# 🧱 Lombok 統一設定檔
# 適用於整個 XK Truck Platform 多模組架構
# -------------------------------------------------------------------
config.stopBubbling = true

# === Getter / Setter 規範 ===
lombok.accessors.chain = true        # setter 可鏈式呼叫
lombok.accessors.fluent = false      # 保留標準 get/set 命名
lombok.anyConstructor.addConstructorProperties = true

# === Logger 命名一致 ===
# 強制所有類別使用 log 作為 logger 名稱
lombok.log.fieldName = log

# === @ToString / @EqualsAndHashCode 排除超類別欄位 ===
# 不調用父類別的 toString 和 equals/hashCode（使用 SKIP 表示不調用）
lombok.toString.callSuper = SKIP
lombok.equalsAndHashCode.callSuper = SKIP

# === @Data 自動包含 @ToString 與 @EqualsAndHashCode ===
lombok.data.flagUsage = WARNING

# === @Builder 配置 ===
lombok.builder.className = Builder
lombok.builder.flagUsage = WARNING
